{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-usage-outreach.dev/v1/funnel.schema.json",
  "title": "Funnel",
  "type": "object",
  "required": [
    "schema_version",
    "input_count",
    "unique_trace_count",
    "duplicate_count",
    "dispositions",
    "decision_file",
    "decision_file_hash",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "input_count": {
      "type": "integer",
      "minimum": 0
    },
    "unique_trace_count": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_count": {
      "type": "integer",
      "minimum": 0
    },
    "dispositions": {
      "type": "object",
      "required": [
        "included",
        "excluded",
        "suppressed",
        "holdout",
        "unresolved"
      ],
      "properties": {
        "included": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        },
        "holdout": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "decision_file": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*//)(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "decision_file_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
