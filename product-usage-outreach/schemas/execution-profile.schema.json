{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-usage-outreach.dev/v1.1/execution-profile.schema.json",
  "title": "Execution Profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "status",
    "match_criteria",
    "required_parameters",
    "capability_dependencies",
    "quick_checks",
    "operating_ranges",
    "runner",
    "supported_outputs",
    "verified_at",
    "evidence_refs",
    "invalidation_triggers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "verified",
        "stale"
      ]
    },
    "match_criteria": {
      "type": "object",
      "required": [
        "channel",
        "deliverable",
        "identity_population",
        "identity_collision_scope",
        "identity_collision_scope_definition_hash",
        "policy_scope",
        "source_ids",
        "output_contract"
      ],
      "properties": {
        "channel": {
          "enum": [
            "email",
            "in-app"
          ]
        },
        "deliverable": {
          "enum": [
            "cohort-ready",
            "audience-ready",
            "activation-ready"
          ]
        },
        "identity_population": {
          "type": "string",
          "minLength": 1
        },
        "identity_collision_scope": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$",
          "not": {
            "const": "unknown"
          }
        },
        "identity_collision_scope_definition_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policy_scope": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "output_contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "required_parameters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      },
      "uniqueItems": true
    },
    "capability_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "implementation_id",
          "version"
        ],
        "properties": {
          "capability_id": {
            "enum": [
              "environment-and-access",
              "usage-signals",
              "identity-resolution",
              "user-customer-context",
              "eligibility-and-suppression",
              "activation-channels",
              "measurement"
            ]
          },
          "implementation_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "quick_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability_id",
          "type",
          "on_failure"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          },
          "capability_id": {
            "enum": [
              "environment-and-access",
              "usage-signals",
              "identity-resolution",
              "user-customer-context",
              "eligibility-and-suppression",
              "activation-channels",
              "measurement"
            ]
          },
          "type": {
            "enum": [
              "access",
              "freshness",
              "fingerprint",
              "event-availability",
              "operating-range",
              "blocker"
            ]
          },
          "on_failure": {
            "const": "adapt-affected-capability"
          },
          "configuration": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "operating_ranges": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "minimum",
          "maximum"
        ],
        "properties": {
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "runner": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "script",
            "stages"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*//)(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          },
          "minItems": 1
        },
        "configuration": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "script"
            }
          },
          "allOf": [
            {
              "not": {
                "required": [
                  "stages"
                ]
              }
            }
          ]
        },
        {
          "required": [
            "kind",
            "stages"
          ],
          "properties": {
            "kind": {
              "const": "stages"
            }
          },
          "allOf": [
            {
              "not": {
                "required": [
                  "path"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "configuration"
                ]
              }
            }
          ]
        }
      ],
      "additionalProperties": false
    },
    "supported_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "invalidation_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "match_criteria"
        ],
        "properties": {
          "match_criteria": {
            "type": "object",
            "required": [
              "deliverable"
            ],
            "properties": {
              "deliverable": {
                "enum": [
                  "audience-ready",
                  "activation-ready"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "capability_dependencies": {
            "contains": {
              "type": "object",
              "required": [
                "capability_id"
              ],
              "properties": {
                "capability_id": {
                  "const": "identity-resolution"
                }
              }
            },
            "minContains": 1
          },
          "quick_checks": {
            "contains": {
              "type": "object",
              "required": [
                "capability_id"
              ],
              "properties": {
                "capability_id": {
                  "const": "identity-resolution"
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "verified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "verified_at": {
            "type": "null"
          }
        }
      }
    }
  ]
}
