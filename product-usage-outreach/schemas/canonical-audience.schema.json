{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.product-usage-outreach.dev/v1/canonical-audience.schema.json",
  "title": "Canonical Audience",
  "type": "object",
  "required": [
    "record_version",
    "trace_key",
    "channel",
    "target_identifier_type",
    "target_identifier",
    "identity_evidence_refs",
    "disposition",
    "holdout_assignment",
    "channel_fields",
    "source_trace"
  ],
  "properties": {
    "record_version": {
      "const": "1.0"
    },
    "trace_key": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "email",
        "in-app"
      ]
    },
    "target_identifier_type": {
      "type": "string",
      "minLength": 1
    },
    "target_identifier": {
      "type": "string",
      "minLength": 1
    },
    "identity_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "disposition": {
      "const": "included"
    },
    "holdout_assignment": {
      "enum": [
        "treatment",
        "not-applicable"
      ]
    },
    "channel_fields": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "source_trace": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  },
  "additionalProperties": false
}
